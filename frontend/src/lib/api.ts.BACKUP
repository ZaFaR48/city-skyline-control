export interface StationApi {
  id: number;
  code: string;
  name: string;
  region: string;
  address: string;
  vpn_ip: string;
  local_ip: string;
  status: string;
  cpu: number;
  ram: number;
  disk: number;
  last_ping_ms: number;
  last_seen: string | null;
  lat: number;
  lng: number;
}

export async function getStations(token: string) {
  const res = await fetch(
    "http://13.140.180.178:8001/api/stations",
    {
      headers: {
        Authorization: `Bearer ${token}`,
      },
    }
  );

  if (!res.ok) {
    throw new Error("Failed to load stations");
  }

  return await res.json();
}
