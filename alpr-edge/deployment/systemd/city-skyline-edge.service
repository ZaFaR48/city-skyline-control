[Unit]
Description=City Skyline Edge API and Local UI (legacy single-service template)
Documentation=file:/opt/city-skyline-edge/docs/UBUNTU_EDGE_DEPLOYMENT.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=cityedge
Group=cityedge
WorkingDirectory=/opt/city-skyline-edge
EnvironmentFile=/etc/city-skyline-edge/edge.env
ExecStart=/opt/city-skyline-edge/.venv/bin/uvicorn app.api.main:app --host ${EDGE_API_HOST} --port ${EDGE_API_PORT}
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/city-skyline-edge
ReadOnlyPaths=/etc/city-skyline-edge
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
