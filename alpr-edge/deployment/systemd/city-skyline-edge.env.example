# Station identity
STATION_CODE=
CAMERA_ID=
CAMERA_NAME=
CAMERA_VENDOR=
CAMERA_LOCAL_IP=

# Local camera stream. Use the camera vendor's RTSP path for this camera.
RTSP_URL=
RTSP_TRANSPORT=tcp
RTSP_CONNECT_TIMEOUT_SECONDS=10
RTSP_READ_TIMEOUT_SECONDS=10
RTSP_RECONNECT_DELAY_SECONDS=3
RTSP_MAX_RECONNECT_DELAY_SECONDS=30
RTSP_LOW_LATENCY=true

# Local API/UI. Keep bound to localhost unless an operator has approved a secure tunnel design.
EDGE_API_HOST=127.0.0.1
EDGE_API_PORT=18080

# Runtime paths on the station mini PC.
EDGE_DATABASE_PATH=/var/lib/city-skyline-edge/sqlite/edge_config.db
FRAME_OUTPUT_DIR=/var/lib/city-skyline-edge/frames
SNAPSHOT_DIR=/var/lib/city-skyline-edge/snapshots
QUEUE_DIR=/var/lib/city-skyline-edge/queue

# PTZ safety. Keep true for the one-station MVP.
PTZ_DRY_RUN=true
ONVIF_HOST=
ONVIF_PORT=80
ONVIF_USERNAME=
ONVIF_PASSWORD=

# Optional central API integration. Leave blank for local-only testing.
CENTRAL_API_URL=
CENTRAL_API_TOKEN=
UPLOAD_TIMEOUT_SECONDS=5
RETRY_INTERVAL_SECONDS=30

# ALPR model files. No models are downloaded by the installer.
PLATE_DETECTOR_MODEL_PATH=
PLATE_OCR_MODEL_PATH=

# Sampling and metadata.
SAMPLE_INTERVAL_SECONDS=5
SNAPSHOT_JPEG_QUALITY=90
PREVIEW_REFRESH_SECONDS=2
DIRECTION=unknown
ZONE_TYPE=paid_parking
LOG_LEVEL=INFO

# Parking session engine
PARKING_TIMEZONE=Asia/Dushanbe
PARKING_START_TIME=07:00
PARKING_END_TIME=22:00
PARKING_FREE_MINUTES=10
PARKING_RATE_TJS_PER_HOUR=3.00
PARKING_ROUNDING_MODE=exact_minute
SESSION_CONFIRMATION_OBSERVATIONS=2
SESSION_CONFIRMATION_WINDOW_SECONDS=120
SESSION_EXIT_MISSES=2
SESSION_EXIT_TIMEOUT_SECONDS=180

# Future real PTZ patrol remains blocked until explicitly approved.
PTZ_AUTO_PATROL=false
PTZ_PATROL_REQUIRE_APPROVAL=true
PTZ_PATROL_APPROVED=false

# CPU-first ALPR pipeline
MODEL_PACK_DIR=/var/lib/city-skyline-edge/models
MODEL_MANIFEST_PATH=/var/lib/city-skyline-edge/models/manifest.json
PILOT_FIXED_PRESET_ID=
VEHICLE_DETECTOR_ENABLED=true
VEHICLE_DETECTOR_MODEL_PATH=/var/lib/city-skyline-edge/models/vehicle/ssd_mobilenet_v1_12.onnx
VEHICLE_DETECTOR_CONFIDENCE=0.40
VEHICLE_DETECTOR_INPUT_SIZE=
VEHICLE_CLASSES=car,bus,truck,motorcycle
PLATE_DETECTOR_BACKEND=hybrid
PLATE_DETECTOR_MODEL_PATH=
PLATE_DETECTOR_CONFIDENCE=0.35
PLATE_MIN_ASPECT_RATIO=1.5
PLATE_MAX_ASPECT_RATIO=7.5
PLATE_MIN_WIDTH_PIXELS=50
PLATE_MAX_CANDIDATES_PER_VEHICLE=5
OCR_BACKEND=rapidocr
OCR_MIN_CONFIDENCE=0.45
OCR_MAX_VARIANTS=5
OCR_ALLOWED_CHARACTERS=0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ
OCR_MODEL_DIR=/var/lib/city-skyline-edge/models/ocr
ALPR_DEDUP_WINDOW_SECONDS=30
ALPR_SAME_PLATE_MAX_DISTANCE=1
ALPR_REPROCESS_INTERVAL_SECONDS=10
ALPR_SAVE_FULL_FRAME=false
ALPR_SAVE_VEHICLE_CROP=true
ALPR_SAVE_PLATE_CROP=true
ALPR_SAVE_REJECTED_CANDIDATES=false
ALPR_MEDIA_RETENTION_DAYS=30
ALPR_REVIEW_MEDIA_RETENTION_DAYS=90
DATASET_COLLECTION_ENABLED=true
DATASET_COLLECTION_REQUIRE_REVIEW=true
